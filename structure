// ---------- Price-level alerts (Pivot + manual AVWAP) — beep + visual flag when the latest close touches/crosses
// a level. Multiple manual AVWAP anchors = multiple buyers' entry price/time, so a touch means price has come
// back to someone's cost basis — useful to notice without eyeballing every line. EOD data, so this fires once
// per new day's data, not live/real-time. ----------
let ALERT_AUDIO_ON = JSON.parse(localStorage.getItem('twv_rzst_alert_audio_v1') ?? 'true');
const ALERTED_KEYS = new Set(); // sym+date+level → dedupe so re-rendering the same scrip/day doesn't re-beep
function playAlertBeep(){
  if(!ALERT_AUDIO_ON) return;
  try{
    const ctxA = new (window.AudioContext||window.webkitAudioContext)();
    const osc = ctxA.createOscillator(), gain = ctxA.createGain();
    osc.type = 'sine'; osc.frequency.value = 880;
    gain.gain.setValueAtTime(0.001, ctxA.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.25, ctxA.currentTime+0.02);
    gain.gain.exponentialRampToValueAtTime(0.001, ctxA.currentTime+0.28);
    osc.connect(gain); gain.connect(ctxA.destination);
    osc.start(); osc.stop(ctxA.currentTime+0.3);
    setTimeout(()=>{ // second short beep for a distinct "alert" cadence
      const osc2 = ctxA.createOscillator(), gain2 = ctxA.createGain();
      osc2.type='sine'; osc2.frequency.value=1100;
      gain2.gain.setValueAtTime(0.001, ctxA.currentTime);
      gain2.gain.exponentialRampToValueAtTime(0.22, ctxA.currentTime+0.02);
      gain2.gain.exponentialRampToValueAtTime(0.001, ctxA.currentTime+0.22);
      osc2.connect(gain2); gain2.connect(ctxA.destination);
      osc2.start(); osc2.stop(ctxA.currentTime+0.24);
    }, 160);
  }catch(e){ /* Web Audio unavailable — fail silently */ }
}
function checkPriceLevelAlerts(sym, bars, pivotSegments, avwapManualList){
  const n = bars.length;
  if(n<2) return [];
  const cur = bars[n-1].c, prev = bars[n-2].c;
  const hits = [];
  const touchOrCross = (level, label)=>{
    if(level==null) return;
    const crossed = (prev-level)*(cur-level) < 0; // sign flip = crossed through it
    const touched = Math.abs(cur-level)/level < 0.003; // within ~0.3% = touched
    if(crossed || touched) hits.push({label, level, type: crossed?'crossed':'touched'});
  };
  const curPivot = pivotSegments.length ? pivotSegments[pivotSegments.length-1] : null;
  if(curPivot){
    touchOrCross(curPivot.pivot, 'Pivot(W)');
    touchOrCross(curPivot.r1, 'Pivot R1');
    touchOrCross(curPivot.s1, 'Pivot S1');
  }
  (avwapManualList||[]).forEach((a,i)=>{
    const arr = avwapFrom(bars, a.globalIdx);
    const lv = arr[arr.length-1];
    touchOrCross(lv, `AVWAP-${a.side==='high'?'H':'L'} #${i+1}`);
  });
  // dedupe per scrip+date+label so switching back and forth doesn't re-beep for the same day's data
  const fresh = hits.filter(h => !ALERTED_KEYS.has(`${sym}|${bars[n-1].date}|${h.label}`));
  fresh.forEach(h => ALERTED_KEYS.add(`${sym}|${bars[n-1].date}|${h.label}`));
  return {all: hits, fresh};
}

