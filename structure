function mergeScrip(sym, rows){
  if(!LIB[sym]) LIB[sym] = [];
  const map = {};
  LIB[sym].forEach(r => map[r.date] = r);
  rows.forEach(r => map[r.date] = r);
  let all = Object.values(map).sort((a,b)=> new Date(a.date) - new Date(b.date));
  // fill missing open (exports with no OPEN PRICE column) from the prior day's close
  for(let i=0;i<all.length;i++){
    if(isNaN(all[i].o)) all[i].o = i>0 ? all[i-1].c : all[i].c;
  }
  // rolling 365-day style cap on bar count to keep it light
  if(all.length > 500) all = all.slice(all.length - 500);
  LIB[sym] = all;
}
