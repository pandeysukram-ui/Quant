// ---------- indicators ----------
function wma(vals, period){
  const out = new Array(vals.length).fill(null);
  let denom = period*(period+1)/2;
  for(let i=period-1;i<vals.length;i++){
    let sum=0;
    for(let j=0;j<period;j++) sum += vals[i-period+1+j]*(j+1);
    out[i] = sum/denom;
  }
  return out;
}
function trueRange(bars){
  const tr = new Array(bars.length).fill(null);
  for(let i=0;i<bars.length;i++){
    if(i===0){ tr[i] = bars[i].h - bars[i].l; continue; }
    tr[i] = Math.max(bars[i].h-bars[i].l, Math.abs(bars[i].h-bars[i-1].c), Math.abs(bars[i].l-bars[i-1].c));
  }
  return tr;
}
function atrWilder(bars, period){
  const tr = trueRange(bars);
  const out = new Array(bars.length).fill(null);
  if(bars.length < period) return out;
  let seed = 0;
  for(let i=0;i<period;i++) seed += tr[i];
  out[period-1] = seed/period;
  for(let i=period;i<bars.length;i++){
    out[i] = (out[i-1]*(period-1) + tr[i]) / period;
  }
  return out;
}
function fractals(bars, wing=4){
  // Williams-style, wing bars each side
  const highF = new Array(bars.length).fill(false);
  const lowF  = new Array(bars.length).fill(false);
  for(let i=wing;i<bars.length-wing;i++){
    let isHigh=true, isLow=true;
    for(let k=1;k<=wing;k++){
      if(bars[i-k].h > bars[i].h || bars[i+k].h > bars[i].h) isHigh=false;
      if(bars[i-k].l < bars[i].l || bars[i+k].l < bars[i].l) isLow=false;
    }
    highF[i]=isHigh; lowF[i]=isLow;
  }
  return {highF, lowF};
}
function rsi(vals, period=14){
  const out = new Array(vals.length).fill(null);
  let gains=0, losses=0;
  for(let i=1;i<=period && i<vals.length;i++){
    const diff = vals[i]-vals[i-1];
    if(diff>=0) gains+=diff; else losses-=diff;
  }
  let avgG=gains/period, avgL=losses/period;
  out[period] = 100 - (100/(1+ (avgL===0?100:avgG/avgL)));
  for(let i=period+1;i<vals.length;i++){
    const diff = vals[i]-vals[i-1];
    const g = diff>0?diff:0, l = diff<0?-diff:0;
    avgG = (avgG*(period-1)+g)/period;
    avgL = (avgL*(period-1)+l)/period;
    out[i] = 100 - (100/(1+ (avgL===0?100:avgG/avgL)));
  }
  return out;
}
function choppiness(bars, period=14){
  const tr = trueRange(bars);
  const out = new Array(bars.length).fill(null);
  for(let i=period;i<bars.length;i++){
    let sumTR=0, hi=-Infinity, lo=Infinity;
    for(let k=i-period+1;k<=i;k++){
      sumTR += tr[k];
      hi = Math.max(hi, bars[k].h);
      lo = Math.min(lo, bars[k].l);
    }
    const range = hi-lo || 0.0001;
    out[i] = 100 * Math.log10(sumTR/range) / Math.log10(period);
  }
  return out;
}
function demarkPivot(prevBar){
  let X;
  if(prevBar.c < prevBar.o) X = prevBar.h + 2*prevBar.l + prevBar.c;
  else if(prevBar.c > prevBar.o) X = 2*prevBar.h + prevBar.l + prevBar.c;
  else X = prevBar.h + prevBar.l + 2*prevBar.c;
  return { pivot: X/4, r1: X/2 - prevBar.l, s1: X/2 - prevBar.h };
}

// ---------- Extra indicator group (KAMA / Hull / CKS / Stochastic / Price Action Filter) ----------
function smaSafe(vals, period){ // like sma() but returns null instead of NaN if any input in the window is null
  const out = new Array(vals.length).fill(null);
  for(let i=period-1;i<vals.length;i++){
    let sum=0, ok=true;
    for(let j=i-period+1;j<=i;j++){ if(vals[j]==null){ ok=false; break; } sum+=vals[j]; }
    out[i] = ok ? sum/period : null;
  }
  return out;
}
// KAMA — Kaufman Adaptive MA, efficiency-ratio lookback 13, fast=2, slow=30
function kama(closes, period=13, fastN=2, slowN=30){
  const n = closes.length;
  const out = new Array(n).fill(null);
  if(n <= period) return out;
  const fastSC = 2/(fastN+1), slowSC = 2/(slowN+1);
  let prevKama = closes[period];
  out[period] = prevKama;
  for(let i=period+1;i<n;i++){
    const change = Math.abs(closes[i]-closes[i-period]);
    let vol=0;
    for(let j=i-period+1;j<=i;j++) vol += Math.abs(closes[j]-closes[j-1]);
    const er = vol===0 ? 0 : change/vol;
    const sc = Math.pow(er*(fastSC-slowSC)+slowSC, 2);
    prevKama = prevKama + sc*(closes[i]-prevKama);
    out[i] = prevKama;
  }
  return out;
}
// Hull MA, period 13 — HMA = WMA(2*WMA(n/2) - WMA(n), sqrt(n))
function hullMA(closes, period=13){
  const half = Math.max(1, Math.round(period/2));
  const sqrtP = Math.max(1, Math.round(Math.sqrt(period)));
  const wmaHalf = wma(closes, half);
  const wmaFull = wma(closes, period);
  const diff = closes.map((_,i)=> (wmaHalf[i]!=null && wmaFull[i]!=null) ? 2*wmaHalf[i]-wmaFull[i] : null);
  const out = new Array(closes.length).fill(null);
  const firstValid = diff.findIndex(v=>v!=null);
  if(firstValid===-1) return out;
  const denom = sqrtP*(sqrtP+1)/2;
  for(let i=firstValid+sqrtP-1;i<diff.length;i++){
    let sum=0, ok=true;
    for(let j=0;j<sqrtP;j++){ const v=diff[i-sqrtP+1+j]; if(v==null){ok=false;break;} sum+=v*(j+1); }
    out[i] = ok ? sum/denom : null;
  }
  return out;
}
// CKS — Chande Kroll Stop (p=10 ATR/HH-LL lookback, x=1 ATR multiplier, q=9 stop lookback)
function cks(bars, p=10, x=1, q=9){
  const n = bars.length;
  const atrArr = atrWilder(bars, p);
  const firstHigh = new Array(n).fill(null), firstLow = new Array(n).fill(null);
  for(let i=p-1;i<n;i++){
    let hh=-Infinity, ll=Infinity;
    for(let k=i-p+1;k<=i;k++){ hh=Math.max(hh,bars[k].h); ll=Math.min(ll,bars[k].l); }
    if(atrArr[i]!=null){ firstHigh[i]=hh-x*atrArr[i]; firstLow[i]=ll+x*atrArr[i]; }
  }
  const longStop = new Array(n).fill(null), shortStop = new Array(n).fill(null);
  for(let i=0;i<n;i++){
    if(firstHigh[i]==null) continue;
    let hh=-Infinity, ok=true;
    for(let k=Math.max(0,i-q+1);k<=i;k++){ if(firstHigh[k]==null){ok=false;break;} hh=Math.max(hh,firstHigh[k]); }
    longStop[i] = ok ? hh : null;
  }
  for(let i=0;i<n;i++){
    if(firstLow[i]==null) continue;
    let ll=Infinity, ok=true;
    for(let k=Math.max(0,i-q+1);k<=i;k++){ if(firstLow[k]==null){ok=false;break;} ll=Math.min(ll,firstLow[k]); }
    shortStop[i] = ok ? ll : null;
  }
  return {longStop, shortStop};
}
// Stochastic Oscillator (14,3,3) — %K raw over 14, smoothed 3, %D = SMA3 of smoothed %K
function stochastic(bars, period=14, kSmooth=3, dSmooth=3){
  const n = bars.length;
  const rawK = new Array(n).fill(null);
  for(let i=period-1;i<n;i++){
    let hh=-Infinity, ll=Infinity;
    for(let k=i-period+1;k<=i;k++){ hh=Math.max(hh,bars[k].h); ll=Math.min(ll,bars[k].l); }
    rawK[i] = (hh-ll)===0 ? 50 : 100*(bars[i].c-ll)/(hh-ll);
  }
