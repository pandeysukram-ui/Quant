    ctx.strokeStyle='#7C83FD'; ctx.lineWidth=1.2; ctx.beginPath();
    let stOW=false;
    obvWmaSlice.forEach((v,i)=>{ if(v==null) return; const px=x(i), py=yObv(v); if(!stOW){ctx.moveTo(px,py); stOW=true;} else ctx.lineTo(px,py); });
    ctx.stroke();
    ctx.font='10px Share Tech Mono';
    ctx.fillStyle='#E8C547'; ctx.fillText('OBV', padL, obvTop-2);
    ctx.fillStyle='#7C83FD'; ctx.fillText('WMA9', padL+40, obvTop-2);
  }

  // ---- Extra: Price−MA21 Gap — raw +/- distance of LTP from MA21 per bar (how much price is lagging/leading
  //      the indicator), histogram + zero line, dynamic scale, only takes space when checked ----
  if(LAYER_VIS.magap){
    ctx.strokeStyle='#152238'; ctx.lineWidth=1; ctx.beginPath();
    ctx.moveTo(padL,magapTop-14); ctx.lineTo(cssW-padR,magapTop-14); ctx.stroke();
    const vals = maGapSlice.filter(v=>v!=null);
    let gHi = vals.length ? Math.max(...vals,0.0001) : 1;
    let gLo = vals.length ? Math.min(...vals,-0.0001) : -1;
    const gPad = (gHi-gLo)*0.15 || 1; gHi+=gPad; gLo-=gPad;
    const yGap = v => magapTop + (1-(v-gLo)/(gHi-gLo))*magapH;
    ctx.setLineDash([3,3]); ctx.strokeStyle='#243350'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(padL,yGap(0)); ctx.lineTo(cssW-padR,yGap(0)); ctx.stroke(); ctx.setLineDash([]);
    const bwG = Math.max(1, plotW/N*0.5); const zeroYg = yGap(0);
    maGapSlice.forEach((v,i)=>{
      if(v==null) return;
      const px=x(i), vY=yGap(v);
      ctx.fillStyle = v>=0 ? 'rgba(38,194,129,0.8)' : 'rgba(225,75,75,0.8)';
      ctx.fillRect(px-bwG/2, Math.min(zeroYg,vY), bwG, Math.max(1,Math.abs(zeroYg-vY)));
    });
    const lastGap = lastVal(maGapSlice);
    ctx.font='10px Share Tech Mono';
    ctx.fillStyle = (lastGap!=null && lastGap>=0) ? '#26C281' : '#E14B4B';
    ctx.fillText(`PRICE−MA21 ${lastGap!=null?(lastGap>=0?'+':'')+lastGap.toFixed(2):'-'}`, padL, magapTop-2);
  }

  // date labels (sparse)
  ctx.fillStyle='#6E8199'; ctx.font='10px Share Tech Mono';
  const step = Math.ceil(N/6);
  for(let i=0;i<N;i+=step){
    ctx.fillText(slice[i].date.slice(0,10), x(i)-18, cssH-4);
  }

  // store geometry so click handler below can convert pixels <-> price/bar-index
  const sliceStartGlobal = bars.length - N;
  chartGeom = {padL, padR, padT, plotW, plotH, hi, lo, N, cssW, cssH, sliceStartGlobal};

  // draw existing rays for this scrip
  const rays = RAYS[sym] || [];
  rays.forEach(r=>{
    const localIdx = r.startBarGlobalIndex - sliceStartGlobal;
    const startX = localIdx >= 0 ? x(localIdx) : padL;
    const py = y(r.price);
    if(py < padT-1 || py > padT+plotH+1) return; // off the visible price range, skip drawing
    ctx.setLineDash([5,3]);
    ctx.strokeStyle = '#E7EEF7'; ctx.lineWidth=1.3;
    ctx.beginPath(); ctx.moveTo(startX, py); ctx.lineTo(cssW-padR, py); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle='#E7EEF7';
    const labelW = 54;
    ctx.fillRect(cssW-padR-labelW, py-9, labelW, 16);
    ctx.fillStyle='#04140F'; ctx.font='10px Share Tech Mono';
    ctx.fillText(r.price.toFixed(2), cssW-padR-labelW+5, py+3);
  });

  // draw existing trend lines for this scrip
  const lines = TRENDLINES[sym] || [];
  lines.forEach(l=>{
    const li1 = l.x1 - sliceStartGlobal, li2 = l.x2 - sliceStartGlobal;
    if(li1 < 0 || li1 > N-1 || li2 < 0 || li2 > N-1) return; // outside current 90-bar view
    const px1=x(li1), py1=y(l.p1), px2=x(li2), py2=y(l.p2);
    ctx.strokeStyle = '#4C8DFF'; ctx.lineWidth=1.6;
    ctx.beginPath(); ctx.moveTo(px1,py1); ctx.lineTo(px2,py2); ctx.stroke();
    [[px1,py1],[px2,py2]].forEach(([cx,cy])=>{
      ctx.beginPath(); ctx.arc(cx,cy,3.5,0,Math.PI*2); ctx.strokeStyle='#4C8DFF'; ctx.fillStyle=cssBg; ctx.fill(); ctx.stroke();
    });
    const s = trendStats(l);
    const angle = Math.atan2(-(py2-py1), (px2-px1)) * 180/Math.PI;
    const lines3 = [
      `${s.priceDiff>=0?'+':''}${s.priceDiff.toFixed(2)} (${s.pct>=0?'+':''}${s.pct.toFixed(1)}%)`,
      `${s.bars} bars (${s.days}d)`,
      `${angle.toFixed(0)}°`
    ];
    const boxX = Math.min(px2+8, cssW-padR-100), boxY = Math.max(padT, Math.min(py2-36, padT+plotH-40));
    ctx.fillStyle = 'rgba(10,18,32,0.92)'; ctx.fillRect(boxX, boxY, 96, 40);
    ctx.strokeStyle = '#1A2740'; ctx.strokeRect(boxX, boxY, 96, 40);
    ctx.fillStyle = '#E7EEF7'; ctx.font='10px Share Tech Mono';
    lines3.forEach((t,i)=> ctx.fillText(t, boxX+6, boxY+13+i*12));
  });

  // draw existing boxes for this scrip
  const boxes = BOXES[sym] || [];
  boxes.forEach(b=>{
    const li1 = b.x1 - sliceStartGlobal, li2 = b.x2 - sliceStartGlobal;
    if(li1 < 0 || li1 > N-1 || li2 < 0 || li2 > N-1) return; // outside current 90-bar view
    const px1=x(li1), px2=x(li2), pyHi=y(b.pHigh), pyLo=y(b.pLow);
    ctx.strokeStyle = '#B084F5'; ctx.lineWidth=1.4;
    ctx.fillStyle = 'rgba(176,132,245,0.07)';
    ctx.fillRect(px1, pyHi, px2-px1, pyLo-pyHi);
    ctx.strokeRect(px1, pyHi, px2-px1, pyLo-pyHi);
    const s = boxStats(b);
    // 50% horizontal (price midpoint)
    const pyMid = y(s.mid);
    ctx.setLineDash([4,3]); ctx.strokeStyle='#B084F5'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(px1,pyMid); ctx.lineTo(px2,pyMid); ctx.stroke();
    // 50% vertical (time midpoint)
    const pxMid = (px1+px2)/2;
    ctx.beginPath(); ctx.moveTo(pxMid,pyHi); ctx.lineTo(pxMid,pyLo); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#B084F5'; ctx.font='10px Share Tech Mono';
    ctx.fillText(`${s.bars} bars · ${s.pct.toFixed(1)}%`, px1+4, pyHi-4 > padT ? pyHi-4 : pyHi+12);
  });

  // box in-progress marker (first corner clicked, waiting on the opposite corner)
  if(activeTool==='box' && boxPending){
    const li = boxPending.globalIdx - sliceStartGlobal;
    if(li>=0 && li<=N-1){
      const cx=x(li), cy=y(boxPending.price);
      ctx.beginPath(); ctx.arc(cx,cy,4,0,Math.PI*2); ctx.strokeStyle='#B084F5'; ctx.fillStyle=cssBg; ctx.fill(); ctx.stroke();
    }
  }

  // trend-line in-progress marker (first point clicked, waiting on second)
  if(activeTool==='trend' && trendPending){
    const li = trendPending.globalIdx - sliceStartGlobal;
    if(li>=0 && li<=N-1){
      const cx=x(li), cy=y(trendPending.price);
      ctx.beginPath(); ctx.arc(cx,cy,4,0,Math.PI*2); ctx.strokeStyle='#4C8DFF'; ctx.fillStyle=cssBg; ctx.fill(); ctx.stroke();
    }
  }

  // click-to-place: ray (single click) or trend line (two clicks)
  canvas.onclick = (e)=>{
    if(!activeTool || !chartGeom) return;
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    const g = chartGeom;
    if(mx < g.padL || mx > g.cssW-g.padR || my < g.padT || my > g.padT+g.plotH) return;
    const price = g.hi - ((my-g.padT)/g.plotH)*(g.hi-g.lo);
    const localIdx = Math.round(((mx-g.padL)/g.plotW)*(g.N-1));
    const globalIdx = g.sliceStartGlobal + Math.max(0, Math.min(g.N-1, localIdx));
    const bar = bars[globalIdx];

    if(activeTool === 'ray'){
      if(!RAYS[sym]) RAYS[sym] = [];
      RAYS[sym].push({price, startBarGlobalIndex: globalIdx, date: bar.date, volume: bar.v});
      saveRays();
      activeTool = null;
      render(sym);
    } else if(activeTool === 'trend'){
      if(!trendPending){
        trendPending = {globalIdx, price, date: bar.date};
        document.getElementById('rayHint').textContent = 'Start point set — click the end point to finish.';
        drawChart(bars, wmaArr, highF, lowF, sym, extra); // redraw to show the pending marker
      } else {
        let a = trendPending, b = {globalIdx, price, date: bar.date};
        if(b.globalIdx < a.globalIdx){ const t=a; a=b; b=t; } // keep chronological order
        if(!TRENDLINES[sym]) TRENDLINES[sym] = [];
        TRENDLINES[sym].push({x1:a.globalIdx, p1:a.price, d1:a.date, x2:b.globalIdx, p2:b.price, d2:b.date});
        saveTrendLines();
        trendPending = null;
        activeTool = null;
        render(sym);
      }
    } else if(activeTool === 'box'){
      if(!boxPending){
        boxPending = {globalIdx, price, date: bar.date};
        document.getElementById('rayHint').textContent = 'First corner set — click the opposite corner to finish.';
        drawChart(bars, wmaArr, highF, lowF, sym, extra); // redraw to show the pending marker
      } else {
        let a = boxPending, b = {globalIdx, price, date: bar.date};
        if(b.globalIdx < a.globalIdx){ const t=a; a=b; b=t; } // chronological order for x
        const pHigh = Math.max(a.price, b.price), pLow = Math.min(a.price, b.price);
        if(!BOXES[sym]) BOXES[sym] = [];
        BOXES[sym].push({x1:a.globalIdx, x2:b.globalIdx, d1:a.date, d2:b.date, pHigh, pLow});
        saveBoxes();
        boxPending = null;
        activeTool = null;
        render(sym);
      }
    } else if(activeTool === 'avwap'){
      // anchor from the clicked bar's high or low, whichever half of the candle was clicked
      const midHL = (bar.h+bar.l)/2;
      const side = price >= midHL ? 'high' : 'low';
      const anchorPrice = side==='high' ? bar.h : bar.l;
      if(!AVWAPS[sym]) AVWAPS[sym] = [];
      AVWAPS[sym].push({globalIdx, side, price: anchorPrice, date: bar.date});
      if(AVWAPS[sym].length >= 5){
        AVWAPS[sym] = AVWAPS[sym].slice(-5); // cap 5, oldest drops off
        activeTool = null; // cap hit — stop the tool so it doesn't silently keep replacing
      }
      // stay in 'avwap' mode otherwise, so the next click places another anchor without re-pressing the button
      saveAvwaps();
      render(sym);
      if(activeTool === 'avwap'){
        document.getElementById('rayHint').textContent = `Anchor placed (${AVWAPS[sym].length}/5) — click again for another, or press ✕ Cancel to stop.`;
        document.getElementById('avwapToggleBtn').textContent = '✕ Cancel';
      }
    }
  };

  // hover / touch tooltip — LTP, date, volume, high/low for the nearest candle
  const showTooltip = (clientX, clientY)=>{
    const g = chartGeom;
    const tooltip = document.getElementById('chartTooltip');
    if(!g || !tooltip) return;
    const rect = canvas.getBoundingClientRect();
    const mx = clientX - rect.left;
    if(mx < g.padL || mx > g.cssW-g.padR){ tooltip.style.display='none'; return; }
    const localIdx = Math.round(((mx-g.padL)/g.plotW)*(g.N-1));
    const globalIdx = g.sliceStartGlobal + Math.max(0, Math.min(g.N-1, localIdx));
    const bar = bars[globalIdx];
    if(!bar){ tooltip.style.display='none'; return; }
    tooltip.innerHTML = `<b>${bar.date}</b><br>LTP ${bar.c.toFixed(2)} &nbsp;H ${bar.h.toFixed(2)} &nbsp;L ${bar.l.toFixed(2)}<br>Vol ${Math.round(bar.v).toLocaleString()}`;
    tooltip.style.display = 'block';
    let leftPx = mx + 12;
    if(leftPx + 155 > g.cssW) leftPx = mx - 165;
    tooltip.style.left = Math.max(0,leftPx) + 'px';
    tooltip.style.top = '6px';
  };
  const hideTooltip = ()=>{ const t=document.getElementById('chartTooltip'); if(t) t.style.display='none'; };
  canvas.onmousemove = (e)=> showTooltip(e.clientX, e.clientY);
  canvas.onmouseleave = hideTooltip;
  canvas.ontouchstart = (e)=>{ if(e.touches[0]) showTooltip(e.touches[0].clientX, e.touches[0].clientY); };
  canvas.ontouchmove = (e)=>{ e.preventDefault(); if(e.touches[0]) showTooltip(e.touches[0].clientX, e.touches[0].clientY); };
  canvas.ontouchend = hideTooltip;
}

renderAll();
</script>


