      const anyOtherChecked = Object.entries(LAYER_VIS).some(([k,v]) => k!==cb.dataset.layer && v);
      if(!cb.checked && !anyOtherChecked){
        cb.checked = true; // revert — refuse to uncheck the last one
        return;
      }
      LAYER_VIS[cb.dataset.layer] = cb.checked;
      saveLayerVis();
      drawChart(bars, wmaArr, highF, lowF, sym, chartExtra);
    };
  });
}

