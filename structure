// ---------- CSV parsing (same convention family as FQ Trade / Cycle Chop) ----------
function detectCol(headers, keys){
  for(const k of keys){
    const idx = headers.findIndex(h => h.toLowerCase().includes(k));
    if(idx !== -1) return idx;
  }
  return -1;
}
function parseCSV(text, fallbackScrip){
  const lines = text.split(/\r?\n/).filter(l => l.trim().length);
  if(lines.length < 2) return {};
  const headers = lines[0].split(',').map(h => h.trim());
  const cDate = detectCol(headers, ['business date','date']);
  const cOpen = detectCol(headers, ['open price','open']);
  const cHigh = detectCol(headers, ['high price','high']);
  const cLow  = detectCol(headers, ['low price','low']);
  const cClose= detectCol(headers, ['close price','close','ltp']);
  const cVol  = detectCol(headers, ['total traded quantity','volume','qty']);
  const cScrip= detectCol(headers, ['symbol','scrip']);
  const bySymbol = {};
  for(let i=1;i<lines.length;i++){
    const parts = lines[i].split(',').map(p=>p.trim().replace(/"/g,''));
    if(parts.length < 5) continue;
    const sym = (cScrip !== -1 ? parts[cScrip] : (fallbackScrip || 'UNKNOWN')).trim().toUpperCase();
    const d = cDate!==-1 ? parts[cDate] : null;
    const o = cOpen!==-1 ? parseFloat((parts[cOpen]||'').replace(/,/g,'')) : NaN;
    const h = parseFloat((parts[cHigh]||'').replace(/,/g,''));
    const l = parseFloat((parts[cLow]||'').replace(/,/g,''));
    const c = parseFloat((parts[cClose]||'').replace(/,/g,''));
    const v = parseFloat((parts[cVol]||'0').replace(/,/g,'')) || 0;
    if(!d || isNaN(h)||isNaN(l)||isNaN(c)) continue;
    if(!bySymbol[sym]) bySymbol[sym] = [];
    // o stays NaN here if the export has no OPEN PRICE column (common NEPSE "Stock Trading of <scrip>" export) —
    // filled in from the prior day's close once the full series is date-sorted, see mergeScrip()
    bySymbol[sym].push({date:d, o, h, l, c, v});
  }
  return bySymbol;
}

