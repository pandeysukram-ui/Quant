let sortCol = 'sym', sortDir = 1;
function computeAllScrips(){
  return Object.keys(LIB).filter(s => LIB[s].length >= 15).map(sym=>{
    const bars = LIB[sym];
    const closes = bars.map(b=>b.c);
    const wmaArr = wma(closes,21);
    const atrArr = atrWilder(bars,21);
    const {highF,lowF} = fractals(bars,4);
    const ci = choppiness(bars,14);
    const {phase} = computePhase(bars,wmaArr,atrArr,highF,lowF);
    const zone = computeZone(bars,wmaArr,ci,highF,lowF);
    const strength = computeStrength(atrArr,bars.length);
    return {sym, bars, phase, zone, strength, last: bars[bars.length-1]};
  });
}
function applyFilters(rows){
  const bias = document.getElementById('fBias').value;
  const phaseF = document.getElementById('fPhase').value;
  const zoneF = document.getElementById('fZone').value;
  const zoneStatusF = document.getElementById('fZoneStatus').value;
  const strengthF = document.getElementById('fStrength').value;
  const groupF = document.getElementById('fGroup').value;
  const search = document.getElementById('fSearch').value.trim().toUpperCase();
  return rows.filter(r=>{
    if(bias!=='all' && r.phase.bias!==bias) return false;
    if(phaseF!=='all' && !r.phase.state.toUpperCase().includes(phaseF)) return false;
    if(zoneF!=='all' && !r.zone.type.toUpperCase().includes(zoneF)) return false;
    if(zoneStatusF!=='all' && r.zone.status!==zoneStatusF) return false;
    if(strengthF!=='all' && r.strength.band!==strengthF) return false;
    if(groupF!=='all' && (SECTOR_MAP[r.sym]||'Unassigned')!==groupF) return false;
    if(search && !r.sym.toUpperCase().includes(search)) return false;
    return true;
  });
}
