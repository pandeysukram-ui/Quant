function drawChart(bars, wmaArr, highF, lowF, sym, extra){
  extra = extra || {};
  const canvas = document.getElementById('chartCanvas');
  const dpr = window.devicePixelRatio || 1;
  const cssW = canvas.clientWidth || 800;

  // panel layout is computed first — subpanels only take space when their checkbox is ON
  const mainTop=46, mainH=292;
  const panelDefs = [ {key:'dpo',h:62}, {key:'macd',h:86}, {key:'mfi',h:62}, {key:'stoch',h:62}, {key:'obv',h:62}, {key:'magap',h:62} ];
  const panelTop = {};
  let curBottom = mainTop+mainH;
  panelDefs.forEach(pd=>{
    if(LAYER_VIS[pd.key]){ curBottom += 28; panelTop[pd.key] = curBottom; curBottom += pd.h; }
  });
  const cssH = curBottom + 22 + 6; // + date-label row + bottom margin

  canvas.width = cssW*dpr; canvas.height = cssH*dpr;
  canvas.style.height = cssH+'px';
  const ctx = canvas.getContext('2d');
  ctx.scale(dpr,dpr);
  ctx.clearRect(0,0,cssW,cssH);
  const cssBg = '#0A1220';

  const N = Math.min(bars.length, 220); // widened for margin-call MA120/MA180 to have a clear, meaningful run of history on-screen
  const off = bars.length-N;
  const slice = bars.slice(off);
  const wmaSlice = wmaArr.slice(off);
  const highFSlice = highF.slice(off);
  const lowFSlice = lowF.slice(off);
  const dcMidSlice = (extra.dcMidArr||[]).slice(off);
  const volSlice = (extra.volArr||[]).slice(off);
  const dpoSlice = (extra.dpoArr||[]).slice(off);
  const macdLineSlice = (extra.macdRes ? extra.macdRes.macdLine : []).slice(off);
  const signalSlice = (extra.macdRes ? extra.macdRes.signalLine : []).slice(off);
  const histSlice = (extra.macdRes ? extra.macdRes.hist : []).slice(off);
  const mfiSlice = (extra.mfiArr||[]).slice(off);
  const ma120Slice = (extra.ma120Arr||[]).slice(off);
  const ma180Slice = (extra.ma180Arr||[]).slice(off);
  const obvSlice = (extra.obvArr||[]).slice(off);
  const obvWmaSlice = (extra.obvWmaArr||[]).slice(off);
  const kamaSlice = (extra.kamaArr||[]).slice(off);
  const hullSlice = (extra.hullArr||[]).slice(off);
  const cksLongSlice = (extra.cksRes ? extra.cksRes.longStop : []).slice(off);
  const cksShortSlice = (extra.cksRes ? extra.cksRes.shortStop : []).slice(off);
  const stochKSlice = (extra.stochRes ? extra.stochRes.kSlow : []).slice(off);
  const stochDSlice = (extra.stochRes ? extra.stochRes.dLine : []).slice(off);
  const pafSlice = (extra.pafFlags||[]).slice(off);
  const kamaHullSlice = (extra.kamaHullArr||[]).slice(off);
  const ma21Slice = (extra.ma21Arr||[]).slice(off);
  const chikouSlice = (extra.chikouArr||[]).slice(off);
  const maGapSlice = (extra.maGapArr||[]).slice(off);
  const emaCrossFastSlice = (extra.emaCrossFastArr||[]).slice(off);
  const emaCrossSlowSlice = (extra.emaCrossSlowArr||[]).slice(off);
  const temaSlice = (extra.temaArr||[]).slice(off);
  const sebSlice = (extra.sebArr||[]).slice(off);
  const avwapHighBandsSlice = {
    vwap:(extra.avwapHighBands?.vwap||[]).slice(off), up1:(extra.avwapHighBands?.up1||[]).slice(off), lo1:(extra.avwapHighBands?.lo1||[]).slice(off),
    up2:(extra.avwapHighBands?.up2||[]).slice(off), lo2:(extra.avwapHighBands?.lo2||[]).slice(off)
  };
  const avwapLowBandsSlice = {
    vwap:(extra.avwapLowBands?.vwap||[]).slice(off), up1:(extra.avwapLowBands?.up1||[]).slice(off), lo1:(extra.avwapLowBands?.lo1||[]).slice(off),
    up2:(extra.avwapLowBands?.up2||[]).slice(off), lo2:(extra.avwapLowBands?.lo2||[]).slice(off)
  };
  const avwapManualSlices = (extra.avwapManual||[]).map(m => ({
    side:m.side,
    vwap:(m.bands?.vwap||[]).slice(off), up1:(m.bands?.up1||[]).slice(off), lo1:(m.bands?.lo1||[]).slice(off)
  }));
  const pivotSegments = extra.pivotSegments || [];

  let hi=-Infinity, lo=Infinity;
  slice.forEach(b=>{hi=Math.max(hi,b.h); lo=Math.min(lo,b.l);});
  const pad = (hi-lo)*0.08;
  hi+=pad; lo-=pad;

  // panel geometry already computed above (panelTop) — just alias here
  const padL=50, padR=16;
  const dpoTop=panelTop.dpo, dpoH=62, macdTop=panelTop.macd, macdH=86, mfiTop=panelTop.mfi, mfiH=62, stochTop=panelTop.stoch, stochH=62, obvTop=panelTop.obv, obvH=62, magapTop=panelTop.magap, magapH=62;
  const padT=mainTop, plotH=mainH; // kept as padT/plotH — rays/trend/box tools and click handlers key off these
  const plotW = cssW-padL-padR;
  const x = i => padL + (i/(N-1))*plotW;
  const y = p => padT + (1-(p-lo)/(hi-lo))*plotH;
  const lineAngle = (slice, lookback=20)=>{
    let iEnd = slice.length-1;
    while(iEnd>=0 && slice[iEnd]==null) iEnd--;
    if(iEnd<0) return null;
    let iStart = Math.max(0, iEnd-lookback);
    while(iStart<iEnd && slice[iStart]==null) iStart++;
    if(iStart>=iEnd) return null;
    return Math.atan2(-(y(slice[iEnd])-y(slice[iStart])), (x(iEnd)-x(iStart))) * 180/Math.PI;
  };
  const lastVal = arr => { for(let i=arr.length-1;i>=0;i--){ if(arr[i]!=null) return arr[i]; } return null; };

  // gridlines
  ctx.strokeStyle = '#152238'; ctx.lineWidth=1; ctx.font='10px Share Tech Mono'; ctx.fillStyle='#6E8199';
  for(let g=0; g<=4; g++){
    const py = padT + (g/4)*plotH;
    ctx.beginPath(); ctx.moveTo(padL,py); ctx.lineTo(cssW-padR,py); ctx.stroke();
    const priceVal = hi - (g/4)*(hi-lo);
    ctx.fillText(priceVal.toFixed(1), 4, py+3);
  }

  // faint corner watermark — sits behind the candles, carries into Share exports automatically
  const logoImg = document.getElementById('brandLogoImg');
  if(logoImg && logoImg.complete && logoImg.naturalWidth){
    const wmSize = 34;
    ctx.save();
    ctx.globalAlpha = 0.28;
    ctx.drawImage(logoImg, padL+4, padT+plotH-wmSize-4, wmSize, wmSize);
    ctx.restore();
  }

  const bw = Math.max(2, plotW/N*0.6);
  slice.forEach((b,i)=>{
    const up = b.c>=b.o;
    ctx.strokeStyle = ctx.fillStyle = up? '#26C281' : '#E14B4B';
    const cx = x(i);
    ctx.beginPath(); ctx.moveTo(cx,y(b.h)); ctx.lineTo(cx,y(b.l)); ctx.stroke();
    const top = y(Math.max(b.o,b.c)), bot = y(Math.min(b.o,b.c));
    ctx.fillRect(cx-bw/2, top, bw, Math.max(1,bot-top));
  });

  // ---- Layer 2: WMA21 ----
  if(LAYER_VIS.wma){
    ctx.strokeStyle = '#F5A524'; ctx.lineWidth=1.6; ctx.beginPath();
    let started=false;
    wmaSlice.forEach((v,i)=>{
      if(v===null) return;
      const px=x(i), py=y(v);
      if(!started){ ctx.moveTo(px,py); started=true; } else ctx.lineTo(px,py);
    });
    ctx.stroke();
  }

  // ---- MA120 / MA180 — margin-call reference lines (banks use these lookback windows for loan-to-value checks) ----
  if(LAYER_VIS.ma120){
    ctx.strokeStyle = '#D4A017'; ctx.lineWidth=1.4; ctx.beginPath();
    let st120=false;
    ma120Slice.forEach((v,i)=>{ if(v==null) return; const px=x(i), py=y(v); if(!st120){ctx.moveTo(px,py); st120=true;} else ctx.lineTo(px,py); });
    ctx.stroke();
  }
  if(LAYER_VIS.ma180){
    ctx.strokeStyle = '#6A5ACD'; ctx.lineWidth=1.4; ctx.beginPath();
    let st180=false;
    ma180Slice.forEach((v,i)=>{ if(v==null) return; const px=x(i), py=y(v); if(!st180){ctx.moveTo(px,py); st180=true;} else ctx.lineTo(px,py); });
    ctx.stroke();
  }

  // ---- MA21 (trend color) — segment-colored by price vs MA: green when close>MA, red when MA>close, blue when equal ----
  if(LAYER_VIS.ma21c){
    ctx.lineWidth=1.6;
    for(let i=1;i<N;i++){
      const v0=ma21Slice[i-1], v1=ma21Slice[i];
      if(v0==null || v1==null) continue;
      const c = slice[i].c, ma = v1;
      const diff = c - ma;
      const eps = ma * 0.0005; // effectively-equal tolerance for real price data
      ctx.strokeStyle = Math.abs(diff) <= eps ? '#4C8DFF' : (diff > 0 ? '#26C281' : '#E14B4B');
      ctx.beginPath(); ctx.moveTo(x(i-1), y(v0)); ctx.lineTo(x(i), y(v1)); ctx.stroke();
    }
  }

  // ---- Chikou Span (21) — today's close plotted 21 bars back; compare it against the candles it now sits beside ----
  if(LAYER_VIS.chikou){
    ctx.setLineDash([5,3]); ctx.strokeStyle='#E7EEF7'; ctx.lineWidth=1.3; ctx.beginPath();
    let stCh=false;
    chikouSlice.forEach((v,i)=>{ if(v==null) return; const px=x(i), py=y(v); if(!stCh){ctx.moveTo(px,py); stCh=true;} else ctx.lineTo(px,py); });
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // ---- Layer 4: DC21 mid (Donchian) ----
  if(LAYER_VIS.dc){
    ctx.strokeStyle = '#4C8DFF'; ctx.lineWidth=1.3; ctx.beginPath();
    let stDc=false;
    dcMidSlice.forEach((v,i)=>{
      if(v==null) return;
      const px=x(i), py=y(v);
