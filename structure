// ---------- Backup / Restore — the fix for "settings/library don't carry over between devices" ----------
// Everything lives in this browser's localStorage only (no server/database), so nothing here is ever
// visible to anyone else and nothing syncs automatically across devices. Backup exports the whole state
// (company library + rays/trend lines/boxes/AVWAP anchors + indicator on/off choices) as one JSON file;
// Restore merges that file back in on any device/browser.
function exportBackup(){
  const payload = {
    version: 1,
    exportedAt: new Date().toISOString(),
    LIB, RAYS, TRENDLINES, BOXES, AVWAPS, LAYER_VIS, SECTOR_MAP
  };
  const blob = new Blob([JSON.stringify(payload)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'reversal_zone_strength_backup_'+new Date().toISOString().slice(0,10)+'.json';
  a.click();
  URL.revokeObjectURL(url);
}
function importBackupFile(file){
  const reader = new FileReader();
  reader.onload = (e)=>{
    try{
      const data = JSON.parse(e.target.result);
      let scripCount = 0;
      if(data.LIB){ LIB = Object.assign({}, LIB, data.LIB); saveLib(); scripCount = Object.keys(data.LIB).length; }
      if(data.RAYS){ RAYS = Object.assign({}, RAYS, data.RAYS); saveRays(); }
      if(data.TRENDLINES){ TRENDLINES = Object.assign({}, TRENDLINES, data.TRENDLINES); saveTrendLines(); }
      if(data.BOXES){ BOXES = Object.assign({}, BOXES, data.BOXES); saveBoxes(); }
      if(data.AVWAPS){ AVWAPS = Object.assign({}, AVWAPS, data.AVWAPS); saveAvwaps(); }
      if(data.LAYER_VIS){ LAYER_VIS = Object.assign({}, LAYER_VIS, data.LAYER_VIS); saveLayerVis(); }
      if(data.SECTOR_MAP){ SECTOR_MAP = Object.assign({}, SECTOR_MAP, data.SECTOR_MAP); saveSectorMap(); }
      alert(`Restore complete — ${scripCount} scrip(s) merged in.`);
      renderScreener();
      if(currentScrip && LIB[currentScrip]) render(currentScrip);
    }catch(err){
      alert('Could not read that backup file — make sure it\'s a JSON file exported from this same tool\'s Backup button.');
    }
  };
  reader.readAsText(file);
}
