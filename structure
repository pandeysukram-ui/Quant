}
// Price Action Filter — flags "clean" bars: real body (>60% of range) on above-average range (>0.5×ATR21).
// Working definition only — tell me if you have a specific rule set and I'll rewire it.
function priceActionFilter(bars, atrArr){
  return bars.map((b,i)=>{
    const range = b.h-b.l;
    const body = Math.abs(b.c-b.o);
    const bodyRatio = range>0 ? body/range : 0;
    const atrOk = atrArr[i]!=null && range > atrArr[i]*0.5;
    return bodyRatio > 0.6 && atrOk;
  });
}
// OBV — On-Balance Volume, plus WMA9 crossover line (volume flow indicator)
function obv(bars){
  const n = bars.length;
  const out = new Array(n).fill(0);
  out[0] = bars[0].v||0;
  for(let i=1;i<n;i++){
    if(bars[i].c > bars[i-1].c) out[i] = out[i-1] + (bars[i].v||0);
    else if(bars[i].c < bars[i-1].c) out[i] = out[i-1] - (bars[i].v||0);
    else out[i] = out[i-1];
  }
  return out;
}

// ---------- Chart-overlay indicators (6-layer chart pack) ----------
function sma(vals, period){
  const out = new Array(vals.length).fill(null);
  let sum=0;
  for(let i=0;i<vals.length;i++){
    sum += vals[i];
    if(i>=period) sum -= vals[i-period];
    if(i>=period-1) out[i] = sum/period;
  }
  return out;
}
function donchianMid(bars, period){
  const out = new Array(bars.length).fill(null);
  for(let i=period-1;i<bars.length;i++){
    let hi=-Infinity, lo=Infinity;
    for(let k=i-period+1;k<=i;k++){ hi=Math.max(hi,bars[k].h); lo=Math.min(lo,bars[k].l); }
    out[i] = (hi+lo)/2;
  }
  return out;
}
// Volatility Index — Wilder ATR(21) trailing-stop line (a.k.a. Volatility System), multiplier default 1
function volStopWilder(bars, atrArr, mult){
  const n = bars.length;
  const out = new Array(n).fill(null);
  let trend=null, stop=null;
  for(let i=0;i<n;i++){
    if(atrArr[i]==null){ continue; }
    const c = bars[i].c;
    if(stop===null){
      trend = (i>0 && c>=bars[i-1].c) ? 'up' : 'down';
      stop = trend==='up' ? c - atrArr[i]*mult : c + atrArr[i]*mult;
      out[i]=stop; continue;
    }
    if(trend==='up'){
      stop = Math.max(stop, c - atrArr[i]*mult);
      if(c < stop){ trend='down'; stop = c + atrArr[i]*mult; }
    } else {
      stop = Math.min(stop, c + atrArr[i]*mult);
      if(c > stop){ trend='up'; stop = c - atrArr[i]*mult; }
    }
    out[i]=stop;
  }
  return out;
}
// Detrended Price Oscillator, period 21 (shift = floor(period/2)+1)
function dpo(closes, period){
  const shift = Math.floor(period/2)+1;
  const smaArr = sma(closes, period);
  const out = new Array(closes.length).fill(null);
  for(let i=shift;i<closes.length;i++){
    if(smaArr[i]==null) continue;
    out[i] = closes[i-shift] - smaArr[i];
  }
  return out;
}
// Chikou Span (Ichimoku lagging line), 21-day — today's close plotted 21 bars back on the time axis, so it
// sits alongside price from 21 sessions ago. Chikou above those older candles = bullish confirmation, below =
// bearish. Paired with DPO(21): DPO strips the trend to show cycle position, Chikou compares raw price
// directly against its own past — used together as a trend-confirmation pair, same 21-day window as this setup.
function chikouSpan(closes, period=21){
  const n = closes.length;
  const out = new Array(n).fill(null);
  for(let i=0; i+period<n; i++) out[i] = closes[i+period];
  return out;
}
// Price − MA21 gap, per bar — the raw +/- lag between LTP and the indicator (not normalized like DPO).
function maGap(closes, maArr){
  return closes.map((c,i)=> maArr[i]!=null ? c-maArr[i] : null);
}
function emaArr(vals, period){
  const out = new Array(vals.length).fill(null);
  const firstIdx = vals.findIndex(v=>v!=null);
  if(firstIdx===-1 || firstIdx+period>vals.length) return out;
  let sum=0;
  for(let j=firstIdx;j<firstIdx+period;j++) sum+=vals[j];
  let prevEma = sum/period;
  out[firstIdx+period-1] = prevEma;
  const k = 2/(period+1);
  for(let i=firstIdx+period;i<vals.length;i++){
    if(vals[i]==null){ out[i]=null; continue; }
    prevEma = vals[i]*k + prevEma*(1-k);
    out[i]=prevEma;
  }
  return out;
}
// TEMA — Triple EMA, period 21: 3*EMA1 - 3*EMA2 + EMA3 (EMA of EMA of EMA)
function tema(closes, period=21){
  const e1 = emaArr(closes, period);
  const e2 = emaArr(e1, period);
  const e3 = emaArr(e2, period);
  return closes.map((_,i)=> (e1[i]!=null && e2[i]!=null && e3[i]!=null) ? 3*e1[i]-3*e2[i]+e3[i] : null);
}
// SEB — Standard Error Bands (Jon Anderson) middle line: ending value of a period-length least-squares
// linear-regression line. Single line only (no upper/lower bands) per request.
function sebLine(closes, period=21){
  const n = closes.length;
  const out = new Array(n).fill(null);
  for(let i=period-1;i<n;i++){
    let sumX=0,sumY=0,sumXY=0,sumXX=0;
    for(let j=0;j<period;j++){
      const xv=j, yv=closes[i-period+1+j];
      sumX+=xv; sumY+=yv; sumXY+=xv*yv; sumXX+=xv*xv;
    }
    const denom = period*sumXX - sumX*sumX;
    const slope = denom===0 ? 0 : (period*sumXY - sumX*sumY)/denom;
    const intercept = (sumY - slope*sumX)/period;
    out[i] = intercept + slope*(period-1);
  }
  return out;
}
// Anchored VWAP — auto-anchors at the most recent confirmed swing high/low fractal, no manual click needed.
// Re-anchors itself every render as a newer fractal confirms (touches a new swing high/low).
function lastFractalIndex(flagArr){
  for(let i=flagArr.length-1;i>=0;i--){ if(flagArr[i]) return i; }
  return null;
}
function avwapFrom(bars, anchorIdx){
  const n = bars.length;
  const out = new Array(n).fill(null);
  if(anchorIdx==null || anchorIdx<0 || anchorIdx>=n) return out;
  let cumPV=0, cumV=0;
  for(let i=anchorIdx;i<n;i++){
    const tp = (bars[i].h+bars[i].l+bars[i].c)/3;
    cumPV += tp*(bars[i].v||0);
    cumV += (bars[i].v||0);
    out[i] = cumV>0 ? cumPV/cumV : bars[i].c;
  }
  return out;
}
// AVWAP + volume-weighted standard-deviation bands (1σ / 2σ) — center line = the AVWAP itself (slope = trend),
// bands act as dynamic R/S around it. Used for the auto swing-anchored pair (matches the nepsealpha-style read).
function avwapWithBands(bars, anchorIdx){
  const n = bars.length;
  const vwap=new Array(n).fill(null), up1=new Array(n).fill(null), lo1=new Array(n).fill(null), up2=new Array(n).fill(null), lo2=new Array(n).fill(null);
  if(anchorIdx==null || anchorIdx<0 || anchorIdx>=n) return {vwap,up1,lo1,up2,lo2};
  let cumPV=0, cumV=0, cumPV2=0;
  for(let i=anchorIdx;i<n;i++){
    const tp = (bars[i].h+bars[i].l+bars[i].c)/3;
    const v = bars[i].v||0;
    cumPV += tp*v; cumV += v; cumPV2 += v*tp*tp;
    const vw = cumV>0 ? cumPV/cumV : tp;
    const variance = cumV>0 ? Math.max(0, cumPV2/cumV - vw*vw) : 0;
    const sd = Math.sqrt(variance);
    vwap[i]=vw; up1[i]=vw+sd; lo1[i]=vw-sd; up2[i]=vw+2*sd; lo2[i]=vw-2*sd;
  }
  return {vwap, up1, lo1, up2, lo2};
}
// MACD (fast, slow, signal) — defaults 5,8,3
function macd(closes, fast=5, slow=8, signalP=3){
  const emaFast = emaArr(closes, fast);
  const emaSlow = emaArr(closes, slow);
  const macdLine = closes.map((_,i)=> (emaFast[i]!=null && emaSlow[i]!=null) ? emaFast[i]-emaSlow[i] : null);
  const signalLine = emaArr(macdLine, signalP);
  const hist = macdLine.map((v,i)=> (v!=null && signalLine[i]!=null) ? v-signalLine[i] : null);
  return {macdLine, signalLine, hist};
}
// MFI — Money Flow Index, period 14. Typical price (pivot-style H+L+C/3) × volume = raw money flow;
// ratio of 14-bar positive vs negative flow → 0-100 oscillator. Reference line at 50 (neutral).
function mfi(bars, period=14){
  const n = bars.length;
  const tp = bars.map(b=>(b.h+b.l+b.c)/3);
  const rawFlow = tp.map((v,i)=> v*(bars[i].v||0));
  const out = new Array(n).fill(null);
  for(let i=period;i<n;i++){
    let pos=0, neg=0;
    for(let k=i-period+1;k<=i;k++){
      if(tp[k] > tp[k-1]) pos += rawFlow[k];
      else if(tp[k] < tp[k-1]) neg += rawFlow[k];
    }
    out[i] = neg===0 ? 100 : 100 - (100/(1 + pos/neg));
  }
  return out;
}
// weekly aggregation (Mon-start ISO week) + DeMark pivot off the last completed week, for the "Pivots DeMark Weekly" overlay
function isoWeekKey(d){
  const date = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  const dayNum = (date.getUTCDay()+6)%7;
  date.setUTCDate(date.getUTCDate()-dayNum+3);
  const firstThursday = new Date(Date.UTC(date.getUTCFullYear(),0,4));
  const week = 1 + Math.round(((date-firstThursday)/86400000 - 3 + ((firstThursday.getUTCDay()+6)%7))/7);
  return date.getUTCFullYear()+'-W'+week;
}
function weeklyBars(bars){
  const map = new Map();
  bars.forEach((b,idx)=>{
    const d = new Date(b.date);
    const key = isNaN(d) ? b.date : isoWeekKey(d);
    if(!map.has(key)) map.set(key, {key, o:b.o, h:b.h, l:b.l, c:b.c, startIdx:idx, endIdx:idx});
    else { const w=map.get(key); w.h=Math.max(w.h,b.h); w.l=Math.min(w.l,b.l); w.c=b.c; w.endIdx=idx; }
  });
  return Array.from(map.values());
}
// One pivot per calendar week (Mon–Fri, max 5 daily candles) — new pivot every Monday off the PRIOR week's O/H/L/C.
// Candles stay daily throughout; only the pivot level steps week to week.
function weeklyPivotSegments(bars){
  const wk = weeklyBars(bars);
  const segs = [];
  for(let i=1;i<wk.length;i++){
    const piv = demarkPivot(wk[i-1]);
    segs.push({startIdx: wk[i].startIdx, endIdx: wk[i].endIdx, pivot:piv.pivot, r1:piv.r1, s1:piv.s1});
  }
  return segs;
}

// ---------- Phase engine (WMA21 + Volatility Index) ----------
function computePhase(bars, wmaArr, atrArr, highF, lowF){
  const n = bars.length;
  const events = [];
  let phase = {state:'INSUFFICIENT DATA', bias:'neutral', detail:'Need 30+ bars.', watchLevel:null, watchType:null};
  if(n < 30) return {phase, events};

  // last confirmed fractal swing high / low (confirmed = 4 bars after it exist)
  let lastSwingLowIdx=-1, lastSwingHighIdx=-1;
  for(let i=n-5;i>=0;i--){
    if(lowF[i] && lastSwingLowIdx===-1) lastSwingLowIdx = i;
    if(highF[i] && lastSwingHighIdx===-1) lastSwingHighIdx = i;
    if(lastSwingLowIdx!==-1 && lastSwingHighIdx!==-1) break;
  }
  // log recent swing events for the panel
  for(let i=n-60;i<n-4;i++){
    if(i<0) continue;
    if(highF[i]) events.push({idx:i, date:bars[i].date, type:'SWING HIGH', price:bars[i].h});
    if(lowF[i]) events.push({idx:i, date:bars[i].date, type:'SWING LOW', price:bars[i].l});
  }

  const last = bars[n-1];
  const lastWMA = wmaArr[n-1];
  const prevWMA = wmaArr[n-2];
  const atrNow = atrArr[n-1];
  const atrAvg21 = (()=>{ let s=0,c=0; for(let i=Math.max(0,n-21);i<n;i++){ if(atrArr[i]!==null){s+=atrArr[i];c++;} } return c? s/c : null; })();

  const aboveWMA = last.c > lastWMA;
  const wmaSlopeUp = lastWMA !== null && prevWMA !== null && lastWMA > prevWMA;
  const volExpanding = atrNow!==null && atrAvg21!==null && atrNow > atrAvg21;

  // touch/retest detection: did price cross WMA in the last 1-3 bars and close back on the original side?
  let retest = false;
  for(let k=1;k<=3;k++){
    const idx = n-1-k;
    if(idx<1) continue;
    const crossedDown = bars[idx].l <= wmaArr[idx] && bars[idx].c > wmaArr[idx];
    const crossedUp = bars[idx].h >= wmaArr[idx] && bars[idx].c < wmaArr[idx];
    if(crossedDown || crossedUp){ retest = true; break; }
  }

  const bias = aboveWMA ? 'bull' : 'bear';

  if(lastSwingLowIdx===-1 && lastSwingHighIdx===-1){
    phase = {state:'BUILDING STRUCTURE', bias, detail:'Not enough confirmed fractal swings yet to set a watch level.', watchLevel:null, watchType:null};
    return {phase, events};
  }

  const watchIdx = bias==='bull' ? lastSwingLowIdx : lastSwingHighIdx;
  const watchLevel = watchIdx!==-1 ? (bias==='bull' ? bars[watchIdx].l : bars[watchIdx].h) : null;
  const watchType = bias==='bull' ? 'swing low' : 'swing high';

  // has the watch level been broken on the latest bar?
  const brokenLow  = bias==='bull' && watchLevel!==null && last.c < watchLevel;
  const brokenHigh = bias==='bear' && watchLevel!==null && last.c > watchLevel;

  if(brokenLow || brokenHigh){
    phase = {
      state: bias==='bull' ? 'TREND END — DOWNSIDE BREAK' : 'TREND END — UPSIDE BREAK',
      bias: bias==='bull' ? 'bear' : 'bull',
      detail: `Close broke the watched ${watchType} at ${watchLevel.toFixed(2)}. Regime shifts like this have typically run 3–5 months on NEPSE — treat as a directional flag, not a fixed forecast.`,
      watchLevel, watchType, broke:true
    };
  } else if(retest){
    phase = {
      state:'RETEST & BOUNCE',
      bias,
      detail:`Price tagged WMA21 and closed back on the ${bias} side. Watching ${watchType} at ${watchLevel? watchLevel.toFixed(2):'—'} as the level that would end this.`,
      watchLevel, watchType
    };
  } else if(volExpanding && ((bias==='bull'&&wmaSlopeUp) || (bias==='bear'&&!wmaSlopeUp))){
    phase = {
      state:'TREND CONTINUATION',
      bias,
      detail:`Price holding ${bias} side of WMA21 with Volatility Index expanding in that direction. Watch level (${watchType}) at ${watchLevel? watchLevel.toFixed(2):'—'}.`,
      watchLevel, watchType
    };
  } else {
    phase = {
      state:'SWING END / PEAK-LOW FORMING',
      bias,
      detail:`Momentum flattening near the last confirmed ${watchType}. Next move is either a fresh push or the first break of ${watchLevel? watchLevel.toFixed(2):'—'}.`,
      watchLevel, watchType
    };
  }
  return {phase, events: events.reverse()};
}

// ---------- Zone engine (RBR / DBR / RBD / DBD) ----------
// Base = a low-choppiness pocket (CI>61.8) bounded by fractals; leg-in / leg-out direction from WMA21 slope over that leg.
function computeZone(bars, wmaArr, ci, highF, lowF){
  const n = bars.length;
  if(n < 40) return {type:'—', status:'—', age:'—', detail:'Need 40+ bars for zone detection.'};

  // find the most recent choppy pocket (CI above 61.8) at least 4 bars long, ending within the last 15 bars
  let baseEnd=-1, baseStart=-1;
  for(let i=n-3;i>=n-25 && i>10;i--){
    if(ci[i]!==null && ci[i] > 61.8){
      if(baseEnd===-1) baseEnd = i;
      baseStart = i;
    } else if(baseEnd!==-1){
      break;
    }
  }
  if(baseEnd===-1) return {type:'NO BASE FORMING', status:'—', age:'—', detail:'No choppy consolidation pocket detected in the last 25 bars.'};

  const legInStart = Math.max(0, baseStart-10);
  const legInUp = wmaArr[baseStart]!==null && wmaArr[legInStart]!==null && wmaArr[baseStart] > wmaArr[legInStart];

  const afterIdx = Math.min(n-1, baseEnd+5);
  const legOutUp = wmaArr[afterIdx]!==null && wmaArr[baseEnd]!==null && wmaArr[afterIdx] > wmaArr[baseEnd];
  const legOutConfirmed = baseEnd < n-3; // some bars have passed since the base ended

  let type;
  if(legInUp && legOutUp) type = 'RALLY-BASE-RALLY (RBR — demand)';
  else if(!legInUp && legOutUp) type = 'DROP-BASE-RALLY (DBR — demand)';
  else if(legInUp && !legOutUp) type = 'RALLY-BASE-DROP (RBD — supply)';
  else type = 'DROP-BASE-DROP (DBD — supply)';

  const status = legOutConfirmed ? 'CONFIRMED' : 'WATCH';

  // fresh vs aged: has price come back into the base's high-low range since?
  let baseHi=-Infinity, baseLo=Infinity;
  for(let i=baseStart;i<=baseEnd;i++){ baseHi=Math.max(baseHi,bars[i].h); baseLo=Math.min(baseLo,bars[i].l); }
  let retested=false;
  for(let i=baseEnd+1;i<n;i++){ if(bars[i].l<=baseHi && bars[i].h>=baseLo){ retested=true; break; } }
  const age = retested ? 'AGED (retested)' : 'FRESH (untested)';

  return {type, status, age, detail:`Base spans ${bars[baseStart].date} → ${bars[baseEnd].date}, range ${baseLo.toFixed(2)}–${baseHi.toFixed(2)}.`};
}

// ---------- Strength engine ----------
function computeStrength(atrArr, n){
  if(n<21 || atrArr[n-1]===null) return {score:0, band:'—', detail:'Not enough data.'};
  let sum=0,count=0;
  for(let i=Math.max(0,n-21); i<n; i++){ if(atrArr[i]!==null){sum+=atrArr[i]; count++;} }
  const avg = sum/count;
  const ratio = atrArr[n-1]/avg; // 1.0 = normal
  const score = Math.max(0, Math.min(10, ratio*5));
  let band, color;
  if(ratio < 0.7){ band='CONTRACTING'; color='var(--dim)'; }
  else if(ratio < 1.1){ band='NORMAL'; color='var(--blue)'; }
  else if(ratio < 1.6){ band='EXPANDING'; color='var(--amber)'; }
  else { band='EXTREME'; color='var(--red)'; }
  return {score, band, color, ratio, detail:`ATR now vs its own 21-bar average: ${(ratio*100).toFixed(0)}%.`};
}

// KAMA/Hull/PAF classifier — Price vs KAMA = supply/demand bias; KAMA+Hull same-direction slope = trend
// confirmation; Price Action Filter pass on that bar = the trigger-quality gate. Per-bar array so both
// the latest read (verdict card) and historical trigger points (chart markers) come from one place.
function kamaHullClassify(bars, kamaArr, hullArr, pafFlags, lookback=4){
  const n = bars.length;
  const out = new Array(n).fill(null);
  for(let i=lookback;i<n;i++){
    if(kamaArr[i]==null || hullArr[i]==null || kamaArr[i-lookback]==null || hullArr[i-lookback]==null) continue;
    const price = bars[i].c;
    const bias = price > kamaArr[i] ? 'demand' : (price < kamaArr[i] ? 'supply' : 'flat');
    const kamaUp = kamaArr[i] > kamaArr[i-lookback], kamaDown = kamaArr[i] < kamaArr[i-lookback];
    const hullUp = hullArr[i] > hullArr[i-lookback], hullDown = hullArr[i] < hullArr[i-lookback];
    const alignedUp = kamaUp && hullUp, alignedDown = kamaDown && hullDown;
    const pafPass = !!pafFlags[i];
    let label, tier;
    if(bias==='demand' && alignedUp && pafPass){ label='STRONG DEMAND'; tier='strong-demand'; }
    else if(bias==='demand'){ label='WEAK / EARLY DEMAND'; tier='weak-demand'; }
    else if(bias==='supply' && alignedDown && pafPass){ label='STRONG SUPPLY'; tier='strong-supply'; }
    else if(bias==='supply'){ label='WEAK / EARLY SUPPLY'; tier='weak-supply'; }
    else { label='NEUTRAL / CHOP'; tier='neutral'; }
    out[i] = {label, tier, bias, alignedUp, alignedDown, pafPass};
  }
  return out;
}
// how many consecutive bars the demand/supply bias (price vs KAMA side) has held — the "continuous up/down" read.
// PAF stays folded into the tier above (it's a per-bar quality gate, not its own persistent state) rather than
// getting a separate box — a bare PASS/no-PASS flag flips every bar and has no "aged/continuing" story of its own.
function biasStreak(kamaHullArr){
  let i = kamaHullArr.length-1;
  while(i>=0 && kamaHullArr[i]==null) i--;
  if(i<0) return {bias:null, streak:0};
  const bias = kamaHullArr[i].bias;
  let streak=0;
  for(let j=i;j>=0;j--){
    if(kamaHullArr[j]==null || kamaHullArr[j].bias!==bias) break;
    streak++;
  }
  return {bias, streak};
}

